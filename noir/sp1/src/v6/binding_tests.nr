//! The exit code and root that `verify` fixes are bound by the proof: on the
//! saved SP1 v6 proof (fixtures/sp1-v6/multiply.json), the Groth16 statement
//! with either input changed is rejected. Each vector recomputes the changed
//! input's GLV components, so the decomposition check passes. With the saved
//! input point L the circuit's MSM disagrees with L; with L moved to match the
//! changed input, the pairing check rejects it. The vectors are generated by
//! scripts/generate_test_vectors.py. Execution only: no proof is made.
use crate::generated::v6_test_vector as vector;
use super::Sp1V6Key;

fn verify_inputs(inputs: [Field; 5], components: [[Field; 2]; 5], raw: [[u128; 3]; 10]) {
    groth16::verify::<Sp1V6Key, 5>(
        inputs,
        raw,
        vector::RESIDUE,
        components,
        vector::ACCUMULATORS,
        vector::QUOTIENT,
        vector::BLOCK_RESIDUALS,
    );
}

#[test]
fn saved_inputs_are_the_pinned_ones() {
    assert(vector::INPUTS[2] == super::SUCCESS_EXIT_CODE);
    assert(vector::INPUTS[3] == super::VK_ROOT);
}

#[test(should_fail_with = "Invalid Groth16 input MSM x")]
fn nonzero_exit_code_is_rejected() {
    verify_inputs(
        vector::INPUTS_EXIT_CODE_ONE,
        vector::COMPONENTS_EXIT_CODE_ONE,
        vector::RAW,
    );
}

#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn shifted_exit_code_is_rejected_by_the_pairing_check() {
    verify_inputs(
        vector::INPUTS_EXIT_CODE_SHIFTED,
        vector::COMPONENTS_EXIT_CODE_SHIFTED,
        vector::RAW_EXIT_CODE_SHIFTED,
    );
}

#[test(should_fail_with = "Invalid Groth16 input MSM x")]
fn vk_root_plus_one_is_rejected() {
    verify_inputs(
        vector::INPUTS_VK_ROOT_PLUS_ONE,
        vector::COMPONENTS_VK_ROOT_PLUS_ONE,
        vector::RAW,
    );
}

// The root that SP1 v6.0.0 proofs carry.
#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn wrong_vk_root_is_rejected_by_the_pairing_check() {
    verify_inputs(
        vector::INPUTS_VK_ROOT_V6_0,
        vector::COMPONENTS_VK_ROOT_V6_0,
        vector::RAW_VK_ROOT_V6_0,
    );
}
