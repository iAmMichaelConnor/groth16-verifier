//! sp1::v6::verify on two saved SP1 v6 Groth16 proofs (fixtures/sp1-v6), and
//! rejections through its public API. `multiply.nr` and `clock.nr` are
//! generated by scripts/generate_test_vectors.py. Execution only: no proof is
//! made. The inputs that sp1::v6::verify fixes (exit code, root) are tested in
//! the sp1 package, which can reach the key.
//!
//! Every test runs per pull request in the fast mode. The nightly constrained
//! run takes only the `nightly` module: one test per stage of the circuit
//! (an accepted proof, a rejection by the input MSM, a rejection by the pairing
//! check). The other tests reach the same stages with other inputs.
mod multiply;
mod clock;

use sp1::v6;

fn verify_multiply<let N: u32>(
    program_vkey: Field,
    public_values: [u8; N],
    proof_nonce: Field,
    components: [[Field; 2]; 5],
    raw: [[u128; 3]; 10],
) {
    v6::verify(
        program_vkey,
        public_values,
        proof_nonce,
        raw,
        multiply::RESIDUE,
        components,
        multiply::ACCUMULATORS,
        multiply::QUOTIENT,
        multiply::BLOCK_RESIDUALS,
    );
}

/// One representative per stage, run constrained nightly (and with the hint's
/// self-check removed by scripts/tests/heavy_constraints_without_hint_guard.py).
mod nightly {
    use super::{multiply, verify_multiply};

    #[test]
    fn multiply_proof_verifies() {
        verify_multiply(
            multiply::PROGRAM_VKEY,
            multiply::PUBLIC_VALUES,
            multiply::PROOF_NONCE,
            multiply::GLV_COMPONENTS,
            multiply::RAW,
        );
    }

    // The program vkey changed and its GLV components recomputed, with the
    // saved input point L: the circuit's MSM disagrees with L.
    #[test(should_fail_with = "Invalid Groth16 input MSM x")]
    fn changed_program_vkey_is_rejected_by_the_msm() {
        verify_multiply(
            multiply::PROGRAM_VKEY + 1,
            multiply::PUBLIC_VALUES,
            multiply::PROOF_NONCE,
            multiply::COMPONENTS_VKEY_STALE_L,
            multiply::RAW,
        );
    }

    // A negated: on the curve, with the saved input point and hints, so it
    // passes the point checks and the input binding and reaches the pairing
    // check. No certificate exists for a false pairing equation; the honest
    // hints leave a nonzero remainder.
    #[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
    fn negated_a_is_rejected_by_the_pairing_check() {
        verify_multiply(
            multiply::PROGRAM_VKEY,
            multiply::PUBLIC_VALUES,
            multiply::PROOF_NONCE,
            multiply::GLV_COMPONENTS,
            multiply::RAW_NEGATED_A,
        );
    }
}

// The pinned exit code and root are the words the saved proofs carry.
#[test]
fn public_inputs_match_the_saved_proofs() {
    assert(
        v6::public_inputs(
            multiply::PROGRAM_VKEY,
            multiply::PUBLIC_VALUES,
            multiply::PROOF_NONCE,
        )
            == multiply::INPUTS,
    );
    assert(
        v6::public_inputs(
            clock::PROGRAM_VKEY,
            clock::PUBLIC_VALUES,
            clock::PROOF_NONCE,
        )
            == clock::INPUTS,
    );
}

#[test]
fn clock_proof_verifies() {
    v6::verify(
        clock::PROGRAM_VKEY,
        clock::PUBLIC_VALUES,
        clock::PROOF_NONCE,
        clock::RAW,
        clock::RESIDUE,
        clock::GLV_COMPONENTS,
        clock::ACCUMULATORS,
        clock::QUOTIENT,
        clock::BLOCK_RESIDUALS,
    );
}

// Input binding. Each vector changes one public input and recomputes its GLV
// components, so the decomposition check passes. With the saved input point L
// ("stale L") the circuit's MSM disagrees with L. With L moved by the change
// times the input's IC point ("moved L"), the MSM agrees and the pairing
// check rejects it. The program vkey with a stale L is in `nightly`.
#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn shifted_program_vkey_is_rejected_by_the_pairing_check() {
    verify_multiply(
        multiply::PROGRAM_VKEY_SHIFTED,
        multiply::PUBLIC_VALUES,
        multiply::PROOF_NONCE,
        multiply::COMPONENTS_VKEY_MOVED_L,
        multiply::RAW_VKEY_MOVED_L,
    );
}

#[test(should_fail_with = "Invalid Groth16 input MSM x")]
fn changed_public_value_is_rejected_by_the_msm() {
    verify_multiply(
        multiply::PROGRAM_VKEY,
        multiply::PUBLIC_VALUES_CHANGED,
        multiply::PROOF_NONCE,
        multiply::COMPONENTS_PUBLIC_VALUES_STALE_L,
        multiply::RAW,
    );
}

#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn changed_public_value_with_moved_l_is_rejected_by_the_pairing_check() {
    verify_multiply(
        multiply::PROGRAM_VKEY,
        multiply::PUBLIC_VALUES_CHANGED,
        multiply::PROOF_NONCE,
        multiply::COMPONENTS_PUBLIC_VALUES_MOVED_L,
        multiply::RAW_PUBLIC_VALUES_MOVED_L,
    );
}

#[test(should_fail_with = "Invalid Groth16 input MSM x")]
fn changed_nonce_is_rejected_by_the_msm() {
    verify_multiply(
        multiply::PROGRAM_VKEY,
        multiply::PUBLIC_VALUES,
        multiply::PROOF_NONCE + 1,
        multiply::COMPONENTS_NONCE_STALE_L,
        multiply::RAW,
    );
}

#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn shifted_nonce_is_rejected_by_the_pairing_check() {
    verify_multiply(
        multiply::PROGRAM_VKEY,
        multiply::PUBLIC_VALUES,
        multiply::PROOF_NONCE_SHIFTED,
        multiply::COMPONENTS_NONCE_MOVED_L,
        multiply::RAW_NONCE_MOVED_L,
    );
}

// These two show only that A, B, C taken from a proof for another key (SP1 v5,
// SP1 v6.0.0) do not satisfy the pairing equation for the saved proof's
// statement. They do not run those proofs with their own statements; that is
// checked at the pairing level in scripts/tests/test_sp1_v6_cross_version.py.
#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn sp1_v5_proof_points_fail_the_pairing_check() {
    verify_multiply(
        multiply::PROGRAM_VKEY,
        multiply::PUBLIC_VALUES,
        multiply::PROOF_NONCE,
        multiply::GLV_COMPONENTS,
        multiply::RAW_V5_PROOF,
    );
}

#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn sp1_v6_0_proof_points_fail_the_pairing_check() {
    verify_multiply(
        multiply::PROGRAM_VKEY,
        multiply::PUBLIC_VALUES,
        multiply::PROOF_NONCE,
        multiply::GLV_COMPONENTS,
        multiply::RAW_V6_0_PROOF,
    );
}
