//! Runtime-key verifier on the saved Circom multiplier proof (public input 33).
//! `vector.nr` is generated by scripts/generate_test_vectors.py. Execution
//! only: no proof is made.
mod vector;

use verifier::{Hints, verify};

fn hints() -> Hints<1> {
    Hints {
        claimed_l: vector::CLAIMED_L,
        magnitudes: vector::MAGNITUDES,
        negative: vector::NEGATIVE,
        residue: vector::RESIDUE,
        accumulators: vector::ACCUMULATORS,
        quotient: vector::QUOTIENT,
        block_residuals: vector::BLOCK_RESIDUALS,
    }
}

// One test per stage, run constrained nightly and by the hint-guard probe
// (scripts/tests/heavy_constraints_without_hint_guard.py): an accepted proof,
// a rejection by the input binding, a false statement and a forged
// certificate rejected by the pairing check. Every test runs per pull request
// in the fast mode.
mod nightly {
    use super::{hints, vector};
    use verifier::{Hints, key_commitment, verify};

    #[test]
    fn saved_proof_verifies_and_returns_the_key_hash() {
        let key = vector::key();
        let hash = verify(key, vector::INPUTS, vector::PROOF, hints());
        assert_eq(hash, key_commitment(key));
    }

    #[test(should_fail_with = "Invalid signed GLV decomposition")]
    fn tampered_public_input_is_rejected() {
        let _ = verify(
            vector::key(),
            [vector::INPUTS[0] + 1],
            vector::PROOF,
            hints(),
        );
    }

    // -A and -B are valid curve points, so these reach the pairing check with the
    // public-input binding intact. No certificate exists for a false pairing
    // equation; the honest hints of the saved proof leave a nonzero remainder.
    #[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
    fn negated_a_is_rejected_by_the_pairing_check() {
        let _ = verify(
            vector::key(),
            vector::INPUTS,
            vector::PROOF_NEGATED_A,
            hints(),
        );
    }

    // A certificate of ones and zeros for the saved, valid proof: the residue
    // relations hold, the Miller-loop relations do not.
    #[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
    fn forged_certificate_is_rejected() {
        let forged = Hints {
            claimed_l: vector::CLAIMED_L,
            magnitudes: vector::MAGNITUDES,
            negative: vector::NEGATIVE,
            residue: vector::FORGED_RESIDUE,
            accumulators: vector::FORGED_ACCUMULATORS,
            quotient: vector::FORGED_QUOTIENT,
            block_residuals: vector::FORGED_BLOCK_RESIDUALS,
        };
        let _ = verify(vector::key(), vector::INPUTS, vector::PROOF, forged);
    }
}

// -B reaches the same pairing-check stage as -A in `nightly`, so it runs in the
// fast mode only.
#[test(should_fail_with = "Quadratic expression hint has a nonzero remainder")]
fn negated_b_is_rejected_by_the_pairing_check() {
    let _ = verify(
        vector::key(),
        vector::INPUTS,
        vector::PROOF_NEGATED_B,
        hints(),
    );
}
